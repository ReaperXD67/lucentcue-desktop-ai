{
  "name": "lucentcue-desktop-ai",
  "version": "0.2.1",
  "private": true,
  "description": "Open-source desktop AI copilot with free OpenRouter models, BYOK, screenshot chat, and visible browser assistance.",
  "license": "MIT",
  "author": "LucentCue contributors",
  "main": "dist-desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "tsx tests/desktop-smoke.ts",
    "format": "prettier --write src desktop shared tests scripts/*.mjs *.ts *.json index.html .github",
    "format:check": "prettier --check src desktop shared tests scripts/*.mjs *.ts *.json index.html .github",
    "start": "electron .",
    "browser:install": "playwright install chromium",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "lucide-react": "1.59.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "app.lucentcue.desktop",
    "productName": "LucentCue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "maintainer": "Aman Kumar <225021191+ReaperXD67@users.noreply.github.com>"
    }
  }
}
